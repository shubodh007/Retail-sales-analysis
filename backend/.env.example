# Copy to .env and adjust. Never commit .env (it holds real credentials).
#
# --------------------------------------------------------------------------
# Local development (defaults work out of the box with the pgserver cluster)
# --------------------------------------------------------------------------
#   python scripts/pgdev.py start   # init on first run, start on 127.0.0.1:5432
#
# DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5432/retail_intelligence
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/retail_intelligence
#
# --------------------------------------------------------------------------
# Production (Supabase). Paste values from the Supabase dashboard
# (Project Settings -> Database). Examples only — never real passwords here.
# --------------------------------------------------------------------------
# Direct connection (migrations, seeding, Spark JDBC):
# DATABASE_URL=postgresql+psycopg2://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# App runtime (Supabase pooler, transaction mode):
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# NOTE: for the pooler, plain "?sslmode=require&pgbouncer=true" is enough —
# the app translates sslmode for asyncpg and disables prepared statements.
#
# --- active defaults (local dev) -------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5432/retail_intelligence
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/retail_intelligence
# Test database (created on demand by tests / pgdev)
TEST_DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5432/retail_intelligence_test
TEST_ASYNC_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/retail_intelligence_test

# Deployment profile: development | production
ENVIRONMENT=development
# Hosting platform injects PORT; only set locally if you need a fixed port.
# PORT=8000

# Comma-separated allowed frontend origins (production: your Vercel URL).
CORS_ORIGINS=http://localhost:5173

# Temporary processing workspace (ephemeral disk). Unset = backend/data_lake.
# UPLOAD_DIR=/tmp/retail-intel/uploads
# DATA_DIR=/tmp/retail-intel/data

# Resource limits (free-tier safe defaults)
MAX_UPLOAD_MB=200
MAX_FORECAST_HORIZON=90
MAX_CONCURRENT_JOBS=2
SPARK_PARTITIONS=8
SPARK_DRIVER_MEMORY=1g
# SPARK_MASTER=local[2]
# POSTGRES_JDBC_JAR=/opt/jdbc/postgresql.jar

# SQLAlchemy pool (conservative for free Supabase projects)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
